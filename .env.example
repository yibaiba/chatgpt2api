# ============================================
# ChatGPT2API environment example
# ============================================

# Required: admin auth key
CHATGPT2API_AUTH_KEY=your_secret_key_here

# Optional: signing secret for HttpOnly session cookies
# Defaults to the admin auth-key hash when omitted.
# CHATGPT2API_SESSION_SECRET=your_session_secret_here

# Optional: public base URL used when returning image URLs.
# When set, `response_format=url` saves files to `data/images/`
# and returns `${CHATGPT2API_BASE_URL}/images/...`.
# CHATGPT2API_BASE_URL=https://your-domain.com
