# ============================================
# ChatGPT2API environment example
# ============================================

# Required: admin auth key
CHATGPT2API_AUTH_KEY=your_secret_key_here

# Optional: signing secret for HttpOnly session cookies
# Defaults to the admin auth-key hash when omitted.
# CHATGPT2API_SESSION_SECRET=your_session_secret_here

# Optional: public base URL used when returning image URLs.
# When set, `response_format=url` saves files to `data/images/`
# and returns `${CHATGPT2API_BASE_URL}/images/...`.
# CHATGPT2API_BASE_URL=https://your-domain.com

# Optional: accounts storage backend.
# Supported values: `json`, `sqlite`
# Defaults to `json` when omitted.
# CHATGPT2API_STORAGE_BACKEND=json

# Optional: sqlite file path for accounts storage.
# Used when `CHATGPT2API_STORAGE_BACKEND=sqlite`.
# Relative paths resolve from the project root.
# CHATGPT2API_STORAGE_SQLITE_PATH=./data/accounts.sqlite3

# Optional: WARP sidecar credentials used by `docker-compose-example.yml`.
# Docker Compose auto-loads `.env` when these variables are present.
# WARP_SOCKS_USER=warp-user
# WARP_SOCKS_PASS=warp-pass
